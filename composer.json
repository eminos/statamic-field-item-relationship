{
    "name": "eminos/statamic-field-item-relationship",
    "type": "statamic-addon",
    "description": "A Statamic addon that adds a Field Item Relationship fieldtype.",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "statamic/cms": "^6.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0",
        "pestphp/pest": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Eminos\\StatamicFieldItemRelationship\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Eminos\\StatamicFieldItemRelationship\\Tests\\": "tests"
        }
    },
    "extra": {
        "statamic": {
            "name": "Statamic Field Item Relationship",
            "description": "A Statamic addon that adds a Field Item Relationship fieldtype."
        },
        "laravel": {
            "providers": [
                "Eminos\\StatamicFieldItemRelationship\\ServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pixelfear/composer-dist-plugin": true,
            "pestphp/pest-plugin": true
        }
    }
}
